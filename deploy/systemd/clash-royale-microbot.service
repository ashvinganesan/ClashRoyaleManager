[Unit]
Description=Clash Royale Discord microbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/ClashRoyaleManager
EnvironmentFile=/etc/clash-royale-microbot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/opc/ClashRoyaleManager:/home/opc/ClashRoyaleManager/.venv/lib/python3.9/site-packages
Environment=MICROBOT_HEARTBEAT_PATH=/run/clash-royale-microbot/heartbeat
RuntimeDirectory=clash-royale-microbot
ExecStart=/usr/bin/python3 -m microbot.bot
Restart=always
RestartSec=10
MemoryAccounting=yes
MemoryMax=180M
MemorySwapMax=256M

[Install]
WantedBy=multi-user.target
