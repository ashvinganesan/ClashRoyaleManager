[Unit]
Description=Clash Royale Discord microbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/ClashRoyaleManager
EnvironmentFile=/etc/clash-royale-microbot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/opc/ClashRoyaleManager:/home/opc/ClashRoyaleManager/.venv/lib/python3.9/site-packages
ExecStart=/usr/bin/python3 -m microbot.bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
